DATABASE_PATH=./data/mcaf.sqlite
# Development-only starter accounts; change these passwords before sharing the app.
# The initializer inserts these only if the email does not already exist and never resets existing credentials.
SEED_SUPERADMIN_EMAIL=superadmin@mcaf.test
SEED_SUPERADMIN_PASSWORD=MCAF-SuperAdmin-Dev-2026!
SEED_ORG_ADMIN_EMAIL=admin@mcaf.test
SEED_ORG_ADMIN_PASSWORD=MCAF-Admin-Dev-2026!
# Optional legacy aliases for the original first Super Admin setup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: require this header when calling POST /api/init during development.
INIT_TOKEN=
# Display timezone defaults to Asia/Kolkata.
DISPLAY_TIMEZONE=Asia/Kolkata
# Legacy businessHoursOnly policy window, interpreted in DISPLAY_TIMEZONE.
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
# Only enable when the app is behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Rule thresholds operate on persisted access events. A count must exceed the request limit.
ANOMALY_REQUEST_LIMIT=30
ANOMALY_REQUEST_WINDOW_SECONDS=300
# A repeated-denial finding opens at the threshold (default 5 in 120 seconds).
ANOMALY_DENIAL_LIMIT=5
ANOMALY_DENIAL_WINDOW_SECONDS=120
# Optional high-severity automatic escalation threshold; unset disables it.
ANOMALY_AUTO_ESCALATE_DENIAL_LIMIT=
